# Clave que deben enviar los clientes en la cabecera X-Api-Key (genera una larga y aleatoria)
API_KEY=
PORT=3008
HOST=127.0.0.1

# OCR: "oci" (por defecto) o "none" (solo capa de texto del PDF)
OCR_PROVIDER=oci
OCI_COMPARTMENT_ID=
# Fichero de config estándar de OCI (por defecto ~/.oci/config). Nunca dentro del repo.
OCI_CONFIG_FILE=
OCI_PROFILE=DEFAULT
OCI_REGION=eu-frankfurt-1

OCR_SOFT_TIMEOUT_MS=20000
MAX_CONCURRENT=3
